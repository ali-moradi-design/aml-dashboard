// Database schema. Release 1: access model, bank data, rules and alerts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Access ----------

enum RoleKey {
  ANALYST
  SUPERVISOR
  COMPLIANCE_MANAGER
  ADMIN
}

model Role {
  id          String           @id @default(cuid())
  key         RoleKey          @unique
  name        String
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique // e.g. "alerts.view", "alerts.decide"
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Region {
  id       String       @id @default(cuid())
  code     String       @unique
  name     String
  branches Branch[]
  users    UserRegion[]
}

model Branch {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  city         String
  country      String
  timezone     String        @default("UTC") // IANA zone, e.g. Europe/Berlin; heatmaps use branch local time
  lat          Float
  lng          Float
  regionId     String
  region       Region        @relation(fields: [regionId], references: [id])
  customers    Customer[]
  accounts     Account[]
  transactions Transaction[]
  alerts       Alert[]
  cases        Case[]
}

// Rank 1 (public) to 4 (strictly confidential). A user sees a record when user.rank >= record.rank.
model ClearanceLevel {
  rank Int    @id
  name String
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  passwordHash  String
  roleId        String
  role          Role          @relation(fields: [roleId], references: [id])
  clearanceRank Int
  regions       UserRegion[]
  sessions      Session[]
  assigned      Alert[]       @relation("AlertAssignee")
  decided       Alert[]       @relation("AlertDecider")
  casesCreated  Case[]        @relation("CaseCreator")
  casesApproved Case[]        @relation("CaseApprover")
  caseMembers   CaseMember[]
  comments      CaseComment[]
  notes         PrivateNote[]
  drafts        FormDraft[]
  createdAt     DateTime      @default(now())
}

model UserRegion {
  userId   String
  regionId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([userId, regionId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // SHA-256 of the cookie token; the raw token is never stored
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

// ---------- Bank ----------

enum CustomerType {
  PERSON
  COMPANY
}

enum KycStatus {
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

model Customer {
  id                    String        @id @default(cuid())
  code                  String        @unique // CU-10021
  type                  CustomerType
  name                  String
  country               String
  city                  String?
  addressLine           String?
  email                 String?       @unique
  phone                 String?
  occupation            String?
  employer              String?
  dateOfBirth           DateTime?
  nationality           String?
  registrationNumber    String? // companies
  incorporationDate     DateTime? // companies
  industry              String? // companies
  sourceOfFunds         String?
  expectedMonthlyVolume Decimal?      @db.Decimal(18, 2) // EUR
  riskScore             Int // 0-100
  pep                   Boolean       @default(false) // politically exposed person
  kycStatus             KycStatus     @default(VERIFIED)
  kycReviewedAt         DateTime?
  clearanceRank         Int           @default(1)
  branchId              String
  branch                Branch        @relation(fields: [branchId], references: [id])
  accounts              Account[]
  alerts                Alert[]
  shareholders          Shareholder[]
  caseParties           CaseParty[]
  createdAt             DateTime      @default(now())

  @@index([branchId])
}

model Shareholder {
  id           String                @id @default(cuid())
  customerId   String
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name         String
  type         CustomerType
  country      String
  sharePercent Decimal               @db.Decimal(5, 2)
  documents    ShareholderDocument[]
}

model ShareholderDocument {
  id            String      @id @default(cuid())
  shareholderId String
  shareholder   Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  kind          String // passport, id-card, register-extract
  number        String
  expiresAt     DateTime?
}

enum AccountStatus {
  ACTIVE
  DORMANT
  CLOSED
}

model Account {
  id           String        @id @default(cuid())
  iban         String        @unique
  currency     String
  status       AccountStatus @default(ACTIVE)
  balance      Decimal       @db.Decimal(18, 2)
  openedAt     DateTime
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  transactions Transaction[]
  alerts       Alert[]

  @@index([customerId])
}

enum Channel {
  CASH
  WIRE
  CARD
  ONLINE
}

enum Direction {
  IN
  OUT
}

model Transaction {
  id                  String    @id @default(cuid())
  ref                 String    @unique // TX-00012345
  accountId           String
  account             Account   @relation(fields: [accountId], references: [id])
  branchId            String
  branch              Branch    @relation(fields: [branchId], references: [id])
  direction           Direction
  channel             Channel
  amount              Decimal   @db.Decimal(18, 2)
  currency            String
  baseAmount          Decimal   @db.Decimal(18, 2) // in EUR
  counterpartyName    String
  counterpartyIban    String?
  counterpartyCountry String
  bookedAt            DateTime
  alerts              Alert[]

  @@index([bookedAt])
  @@index([accountId, bookedAt])
  @@index([branchId, bookedAt])
  @@index([baseAmount])
}

// ---------- Monitoring ----------

enum RiskLevel {
  HIGH
  MEDIUM
  LOW
}

model Rule {
  id          String    @id @default(cuid())
  code        String    @unique // R-STRUCT
  name        String
  description String
  criteria    Json // AND/OR tree, see packages/shared criteria schema
  riskLevel   RiskLevel
  enabled     Boolean   @default(true)
  alerts      Alert[]
  createdAt   DateTime  @default(now())
}

enum AlertStatus {
  NEW
  IN_REVIEW
  CLOSED_FALSE_POSITIVE
  ESCALATED
}

model Alert {
  id            String       @id @default(cuid())
  code          String       @unique // AL-24817
  ruleId        String
  rule          Rule         @relation(fields: [ruleId], references: [id])
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  branchId      String
  branch        Branch       @relation(fields: [branchId], references: [id])
  riskLevel     RiskLevel
  score         Int // 0-100
  status        AlertStatus  @default(NEW)
  clearanceRank Int          @default(1)
  assigneeId    String?
  assignee      User?        @relation("AlertAssignee", fields: [assigneeId], references: [id])
  decidedById   String?
  decidedBy     User?        @relation("AlertDecider", fields: [decidedById], references: [id])
  decisionNote  String?
  decidedAt     DateTime?
  caseId        String?
  case          Case?        @relation(fields: [caseId], references: [id])
  createdAt     DateTime

  @@index([status, createdAt])
  @@index([branchId, createdAt])
  @@index([ruleId])
  @@index([customerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // "alert.decide", "auth.login"
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------- Cases (release 2) ----------

enum CaseStatus {
  DRAFT
  OPEN
  PENDING_APPROVAL
  APPROVED
  REPORTED
  CLOSED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseRecommendation {
  FILE_SAR
  MONITOR
  CLOSE
}

model Case {
  id             String              @id @default(cuid())
  code           String              @unique // CS-1001
  title          String
  status         CaseStatus          @default(OPEN)
  priority       CasePriority        @default(MEDIUM)
  riskLevel      RiskLevel
  typology       String // structuring, layering, ...
  summary        String
  findings       String?
  recommendation CaseRecommendation?
  totalAmount    Decimal?            @db.Decimal(18, 2) // EUR
  periodStart    DateTime?
  periodEnd      DateTime?
  dueAt          DateTime
  sarReference   String?
  clearanceRank  Int                 @default(1)
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id])
  createdById    String
  createdBy      User                @relation("CaseCreator", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?               @relation("CaseApprover", fields: [approvedById], references: [id])
  submittedAt    DateTime?
  approvedAt     DateTime?
  reportedAt     DateTime?
  closedAt       DateTime?
  alerts         Alert[]
  parties        CaseParty[]
  documents      CaseDocument[]
  comments       CaseComment[]
  notes          PrivateNote[]
  members        CaseMember[]
  events         CaseEvent[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([branchId])
}

enum PartyRole {
  SUBJECT
  COUNTERPARTY
  BENEFICIAL_OWNER
  OTHER
}

model CaseParty {
  id         String             @id @default(cuid())
  caseId     String
  case       Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?          @relation(fields: [customerId], references: [id])
  name       String
  type       CustomerType
  role       PartyRole
  country    String
  notes      String?
  accounts   CasePartyAccount[]
}

model CasePartyAccount {
  id       String    @id @default(cuid())
  partyId  String
  party    CaseParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  iban     String
  bankName String
  currency String
}

model CaseDocument {
  id           String       @id @default(cuid())
  caseId       String
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      CaseComment? @relation(fields: [commentId], references: [id])
  name         String
  mimeType     String
  size         Int
  storageKey   String
  uploadedById String
  createdAt    DateTime     @default(now())
}

model CaseComment {
  id        String            @id @default(cuid())
  caseId    String
  case      Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User              @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    CaseComment?      @relation("CommentThread", fields: [parentId], references: [id])
  replies   CaseComment[]     @relation("CommentThread")
  body      String
  mentions  String[] // user ids
  edits     CaseCommentEdit[]
  documents CaseDocument[]
  createdAt DateTime          @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([caseId, createdAt])
}

model CaseCommentEdit {
  id        String      @id @default(cuid())
  commentId String
  comment   CaseComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  body      String // previous text
  editedAt  DateTime    @default(now())
}

/// Visible only to its author (access layer 4 applies to comments and notes).
model PrivateNote {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  updatedAt DateTime @updatedAt

  @@unique([caseId, authorId])
}

model CaseMember {
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  addedById String
  createdAt DateTime @default(now())

  @@id([caseId, userId])
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String?
  type      String // created, status_changed, party_added, document_added, member_added, comment_added
  data      Json?
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

/// Autosaved drafts of multi-step forms, one per user and form.
model FormDraft {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "case", "customer"
  data      Json
  step      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, kind])
}
