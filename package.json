{
  "name": "aml-dashboard",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tw:check": "node scripts/tailwind-canonical.mjs apps/web",
    "tw:fix": "node scripts/tailwind-canonical.mjs apps/web --fix",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3"
  }
}
